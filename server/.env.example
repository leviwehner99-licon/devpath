NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://devpath_app:replace-me@localhost:5432/devpath
DATABASE_SSL=false
# Issuer and audience must match the selected OIDC identity provider.
OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=devpath-api
OIDC_JWKS_URI=https://identity.example.invalid/.well-known/jwks.json
# Comma-separated exact origins. Do not use * in production.
CORS_ORIGINS=http://localhost:5173,tauri://localhost,https://tauri.localhost
